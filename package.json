{
  "name": "tg-threadifier-bot",
  "version": "0.4.0",
  "private": true,
  "description": "Telegram bot that relocates offtopic discussions into helper-chat threads",
  "license": "MIT",
  "type": "module",
  "packageManager": "nub@0.9.7",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.9.7",
      "onFail": "ignore"
    }
  },
  "scripts": {
    "dev": "vite-node src/index.ts",
    "build": "nub run i18n:compile && vite build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test": "nub run i18n:compile && vitest run",
    "test:watch": "vitest",
    "test:e2e": "nub run i18n:compile && vitest run tests/e2e",
    "e2e:login": "vite-node scripts/e2e-login.ts",
    "release": "release-it",
    "release:ci": "release-it --ci"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@hono/node-server": "^2.1.5",
    "@lingui/core": "^6.10.1",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "hono": "^4.13.14",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lingui/babel-plugin-lingui-macro": "^6.10.1",
    "@lingui/cli": "^6.10.1",
    "@lingui/conf": "^6.10.1",
    "@lingui/vite-plugin": "^6.10.1",
    "@release-it/conventional-changelog": "^10.0.0",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "release-it": "^19.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-node": "^5.3.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": true
  }
}
