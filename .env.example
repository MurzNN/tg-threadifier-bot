# Telegram BotFather token (use a Test DC token for E2E; never commit real tokens)
BOT_TOKEN=

# grammY Bot API environment: prod (default) | test (Telegram Test DCs)
# TELEGRAM_ENVIRONMENT=prod

# HTTP listen port for health (and later webhook / Mini App)
PORT=3000

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Public Mini App origin (M4 / Helm ingress). Optional until Mini App ships.
# WEBAPP_URL=https://threadifier.example.com

# Database (PostgreSQL dialect only):
# - omit or file:… → local PGlite data directory (default file:./data/threadifier-pg)
# - postgres://… / postgresql://… → real Postgres (Helm / staging / prod)
DATABASE_URL=file:./data/threadifier-pg
# DATABASE_URL=postgres://user:pass@localhost:5432/threadifier
# ${NAME} is replaced from the environment (unset names fail at startup):
# DATABASE_PASSWORD=secret
# DATABASE_URL=postgresql://app:${DATABASE_PASSWORD}@localhost:5432/app

# Optional boot seed into chat_pairs (local / Test DC). Prefer /pair slash commands for operators.
# SOURCE_CHAT_ID=
# TARGET_CHAT_ID=

# --- Test DC E2E only (scripts/e2e-login.ts, tests/e2e) — never required for unit/integration ---
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# MTCUTE_SESSION_MODERATOR=
# MTCUTE_SESSION_MEMBER=
