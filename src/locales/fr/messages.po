"{1}"
msgstr "Ce chat figure dans {0} paires :\n"
"{1}"

#. placeholder {0}: enabled.length
#: src/bot/commands/pair.ts
msgid "This chat is not in an enabled pair. Enabled pairs: {0}."
msgstr "Ce chat ne fait pas partie d'une paire activée. Paires activées : {0}."

#: src/bot/commands/pair.ts
msgid "This chat is not paired. Admins can run /pair source or /pair target here."
msgstr "Ce chat n'est pas apparié. Les administrateurs peuvent exécuter /pair source ou /pair target ici."

