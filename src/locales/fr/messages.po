#. Callback answer when the relocate confirmation is no longer in memory, for example after a bot restart.
#: src/bot/relocate/templates.ts
msgid "This confirmation has expired."
msgstr "Cette confirmation a expiré."

#: src/bot/commands/pair.ts
msgid "This pair was configured by another user."
msgstr "Cette paire a été configurée par un autre utilisateur."

#: src/bot/commands/pair.ts
msgid "This source and target are already paired by another user."
msgstr "Cette source et cette cible sont déjà associées par un autre utilisateur."

#. Relocate confirmation. {threadTitle} is the title the new thread would use. Already escaped for Telegram HTML.
#: src/bot/relocate/templates.ts
msgid "Thread: {threadTitle}"
msgstr "Fil : {threadTitle}"

#. Thread header in a forum topic. The link is another topic in the same group, not a different chat. Thread means a reply thread, not a forum topic.
#: src/bot/relocate/templates.ts
msgid "Thread: {threadTitle}\n"
"Initiated by the user <a href=\"{linkToUser}\">{userDisplayName}</a> in <a href=\"{linkToSourceChat}\">another topic</a>.\n"
"<a href=\"{threadLink}\">Thread link</a>."
msgstr "Fil : {threadTitle}\n"
"Initié par l'utilisateur <a href=\"{linkToUser}\">{userDisplayName}</a> dans <a href=\"{linkToSourceChat}\">un autre sujet</a>.\n"
"<a href=\"{threadLink}\">Lien du fil</a>."

#: src/bot/relocate/templates.ts
msgid "Thread: {threadTitle}\n"
"Initiated by the user <a href=\"{linkToUser}\">{userDisplayName}</a> in the chat <a href=\"{linkToSourceChat}\">{sourceChatName}</a>.\n"
"<a href=\"{threadLink}\">Thread link</a>."
msgstr "Fil : {threadTitle}\n"
"Lancé par l'utilisateur <a href=\"{linkToUser}\">{userDisplayName}</a> dans le chat <a href=\"{linkToSourceChat}\">{sourceChatName}</a>.\n"
"<a href=\"{threadLink}\">Lien du fil</a>."

#. Inline button that adds the forwarded messages to an existing thread. {threadTitle12} is that thread's title shortened to 12 characters.
#: src/bot/relocate/templates.ts
msgid "Thread: {threadTitle12}"
msgstr "Fil : {threadTitle12}"

#: src/bot/commands/pair.ts
msgid "Usage: /pair source, /pair target, or /pair forum (run inside the group). /pair alone shows pairing status."
msgstr "Utilisation : /pair source, /pair target ou /pair forum (à lancer dans le groupe). /pair seul affiche l'état de l'appariement."

#: src/bot/relocate/templates.ts
msgid "user"
msgstr "utilisateur"

#. /start welcome. {operatorGuideUrl} is the public operator setup guide.
#: src/bot.ts
msgid "When moderators forward offtopic from the main chat to the helper chat, I rebuild it as a thread and leave a link behind.\n"
"\n"
"Operators: run /pair source and /pair target in the groups, or /pair forum in a forum group, then check /status.\n"
"Guide: {operatorGuideUrl}"
msgstr "Lorsque les modérateurs transfèrent le hors-sujet du chat principal vers le chat d'aide, je le reconstitue en fil et je laisse un lien.\n"
"\n"
"Opérateurs : lancez /pair source et /pair target dans les groupes, ou /pair forum dans un groupe forum, puis consultez /status.\n"
"Guide : {operatorGuideUrl}"

#. Sent in the target chat when the person who forwarded no longer has permission to delete messages in the source chat. Nothing is deleted.
#: src/bot/relocate/templates.ts
msgid "You need permission to delete messages in the source chat to relocate these forwards. Nothing was deleted."
msgstr "Vous devez avoir le droit de supprimer des messages dans le chat source pour relocaliser ces transferts. Rien n'a été supprimé."
