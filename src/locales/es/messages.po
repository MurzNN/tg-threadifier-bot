#: src/bot/commands/pair.ts
msgid "This chat is the target in pair #{0} (disabled).\n"
"Source: {source}\n"
"Target: {target}"
msgstr "Este chat es el destino en el par #{0} (desactivado).\n"
"Origen: {source}\n"
"Destino: {target}"

