msgstr "#{0} (activado): {source} → {target}"

#. Inline button in the helper chat. Opens a list of recent threads so the forwarded messages can be added to one of them.
#: src/bot/relocate/templates.ts
msgid "Attach to a previous thread"
msgstr "Adjuntar a un hilo anterior"

#. Reply to /language. {languageName} is the current bot language's own name, such as English or Français.
#: src/bot/commands/language.ts
msgid "Choose a language. Current: {languageName}."
msgstr "Elige un idioma. Actual: {languageName}."

#. Prompt in the helper chat. The moderator picks one of the recent threads listed on the buttons below.
#: src/bot/relocate/templates.ts
msgid "Choose a thread for these messages."
msgstr "Elige un hilo para estos mensajes."

#. Telegram command menu description for /language. Opens the bot language picker.
#: src/bot/commands/menu.ts
msgid "Choose language"
msgstr "Elegir idioma"

#. placeholder {0}: lines.join("\n")
#: src/bot/commands/pair.ts
msgid "Configured pairs:\n"
"{0}"
msgstr "Pares configurados:\n"
"{0}"

#. Sent in the helper chat when deleting the forwarded messages of a cancelled relocate fails. The confirmation stays open.
#: src/bot/relocate/templates.ts
msgid "Could not delete these messages. The confirmation is still open."
msgstr "No se pudieron eliminar estos mensajes. La confirmación sigue abierta."

#: src/bot/relocate/templates.ts
msgid "Could not finish relocating this discussion (stopped at {phase}). No further messages were deleted."
msgstr "No se pudo terminar de trasladar esta conversación (se detuvo en {phase}). No se eliminaron más mensajes."

#: src/bot/relocate/templates.ts
msgid "Could not match these forwards to stored source messages, so nothing was deleted. The bot only relocates messages it has already seen."
msgstr "No se pudieron asociar estos reenvíos con los mensajes de origen guardados, así que no se eliminó nada. El bot solo traslada mensajes que ya ha visto."

#. Inline button in the helper chat. Creates a new reply thread from the forwarded messages in this confirmation.
#: src/bot/relocate/templates.ts
msgid "Create new thread"
msgstr "Crear un hilo nuevo"

#. Telegram command menu description for /unpair. Deletes the caller's chat pairs that include this chat.
#: src/bot/commands/menu.ts
msgid "Delete the chat pair"
msgstr "Eliminar el par de chats"

#. Inline button in the helper chat. Deletes the forwarded messages grouped by this confirmation and cancels creating or attaching a thread. Does not delete the originals in the main chat.
#: src/bot/relocate/templates.ts
msgid "Delete these messages"
msgstr "Eliminar estos mensajes"

#: src/bot/commands/pair.ts
msgid "Deleted {deleted} chat pair(s) involving this chat."
msgstr "Se eliminaron {deleted} par(es) de chats que incluyen este chat."

#. placeholder {0}: lines.join("\n")
#: src/bot/commands/pair.ts
msgid "Enabled pairs:\n"
"{0}"
msgstr "Pares activados:\n"
"{0}"

#. Confirmation after the user picks a bot language. {languageName} is that language's own name, such as Español.
#: src/bot/commands/language.ts
msgid "Language set to {languageName}."
msgstr "Idioma establecido: {languageName}."

#. Telegram command menu description for /pair. Links a source chat and a target chat.
#: src/bot/commands/menu.ts
msgid "Link source and target chats"
msgstr "Vincular los chats de origen y destino"

#: src/bot/relocate/templates.ts
msgid "Media message"
msgstr "Mensaje multimedia"

#: src/bot/commands/pair.ts
msgid "No chat pair includes this chat."
msgstr "Ningún par de chats incluye este chat."

#: src/bot/commands/pair.ts
msgid "No chat pairs configured. Run /pair source and /pair target inside the group chats to link."
msgstr "No hay pares de chats configurados. Ejecuta /pair source y /pair target dentro de los chats de grupo para vincularlos."

#: src/bot/commands/pair.ts
msgid "No enabled chat pairs. Use /pair source and /pair target."
msgstr "No hay pares de chats activados. Usa /pair source y /pair target."

#. Callback alert when the moderator wants to attach forwards but this helper chat has no threads yet.
#: src/bot/relocate/templates.ts
msgid "No previous threads in this chat yet."
msgstr "Todavía no hay hilos anteriores en este chat."

#: src/bot/commands/pair.ts
msgid "Only chat admins can configure pairs."
msgstr "Solo los administradores del chat pueden configurar pares."

#. Callback answer when someone other than the moderator who forwarded the messages presses a relocate button.
#: src/bot/relocate/templates.ts
msgid "Only the person who forwarded these messages can choose."
msgstr "Solo quien reenvió estos mensajes puede elegir."

#. placeholder {0}: pair.sourceChatId
#. placeholder {1}: pair.targetChatId
#: src/bot/commands/pair.ts
msgid "Pair enabled: source {0} → target {1}. Ingest is active for both chats."
msgstr "Par activado: origen {0} → destino {1}. El registro de mensajes está activo en ambos chats."

#: src/bot/commands/pair.ts
msgid "Run /pair source or /pair target inside the group chats to link."
msgstr "Ejecuta /pair source o /pair target dentro de los chats de grupo para vincularlos."

#: src/bot/commands/pair.ts
msgid "Run /unpair inside a linked source or target chat."
msgstr "Ejecuta /unpair dentro de un chat de origen o de destino vinculado."

#. Prompt in the helper chat. The moderator's next plain message becomes the thread title and is stored in full, without the 120-character limit.
#: src/bot/relocate/templates.ts
msgid "Send the thread title. It will be used as entered."
msgstr "Envía el título del hilo. Se usará tal como lo escribas."

#. Inline button in the helper chat. Asks the moderator to type a thread title instead of the automatic one.
#: src/bot/relocate/templates.ts
msgid "Set custom thread title"
msgstr "Poner un título personalizado"

#. Telegram command menu description for /status
#: src/bot/commands/menu.ts
msgid "Show the enabled chat pair"
msgstr "Mostrar el par de chats activado"

#. Telegram command menu description for /start
#: src/bot/commands/menu.ts
msgid "Show the welcome message"
msgstr "Mostrar el mensaje de bienvenida"

#: src/bot/commands/pair.ts
msgid "Source and target must be different chats. Use /pair again in each chat."
msgstr "El origen y el destino deben ser chats distintos. Vuelve a usar /pair en cada chat."

#: src/bot/relocate/templates.ts
msgid "source chat"
msgstr "chat de origen"

#. placeholder {0}: ctx.chat.id
#: src/bot/commands/pair.ts
msgid "Source chat recorded ({0}). Now run /pair target in the helper chat."
msgstr "Chat de origen registrado ({0}). Ahora ejecuta /pair target en el chat auxiliar."

#: src/bot/relocate/templates.ts
msgid "target chat"
msgstr "chat de destino"

#. placeholder {0}: ctx.chat.id
#: src/bot/commands/pair.ts
msgid "Target chat recorded ({0}). Now run /pair source in the main chat."
msgstr "Chat de destino registrado ({0}). Ahora ejecuta /pair source en el chat principal."

#: src/bot/commands/language.ts
msgid "That language is not available. Choose one of the buttons below."
msgstr "Ese idioma no está disponible. Elige uno de los botones de abajo."

#. Callback answer when the chosen thread no longer exists in this helper chat.
#: src/bot/relocate/templates.ts
msgid "That thread is no longer available."
msgstr "Ese hilo ya no está disponible."

#: src/bot/relocate/templates.ts
msgid "The message \"{threadTitle}\" from <a href=\"{linkToUser}\">{userDisplayName}</a> with responses forwarded to the chat <a href=\"{linkToTargetChatThread}\">{targetChatName}</a>. Please continue the conversation there."
msgstr "El mensaje «{threadTitle}» de <a href=\"{linkToUser}\">{userDisplayName}</a>, con las respuestas, se reenvió al chat <a href=\"{linkToTargetChatThread}\">{targetChatName}</a>. Continúa la conversación allí."

