msgid "This chat is in {0} pairs:\n"
"{1}"
msgstr "Este chat está en {0} pares:\n"
"{1}"

#. placeholder {0}: enabled.length
#: src/bot/commands/pair.ts
msgid "This chat is not in an enabled pair. Enabled pairs: {0}."
msgstr "Este chat no está en un par activado. Pares activados: {0}."

#: src/bot/commands/pair.ts
msgid "This chat is not paired. Admins can run /pair source or /pair target here."
msgstr "Este chat no está emparejado. Los administradores pueden ejecutar aquí /pair source o /pair target."

#. placeholder {0}: here.id
#. placeholder {1}: here.sourceChatId
#. placeholder {2}: here.targetChatId
#: src/bot/commands/pair.ts
